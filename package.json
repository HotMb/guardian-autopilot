{
  "name": "guardian-autopilot",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HotMb/guardian-autopilot.git"
  },
  "homepage": "https://github.com/HotMb/guardian-autopilot#readme",
  "bugs": {
    "url": "https://github.com/HotMb/guardian-autopilot/issues"
  },
  "type": "module",
  "bin": {
    "guardian": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:shared": "npm run build --prefix packages/shared",
    "build:core": "npm run build --prefix packages/core",
    "build:cli": "npm run build --prefix packages/cli",
    "scan": "node dist/cli.js scan",
    "test": "npm run build && npm run build:shared && node --test tests/*.test.mjs && npm run test --prefix packages/shared && npm run test --prefix packages/core && npm run test --prefix packages/cli",
    "test:shared": "npm run test --prefix packages/shared",
    "test:core": "npm run test --prefix packages/core",
    "test:cli": "npm run test --prefix packages/cli",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "start:webhook": "node dist/cli.js webhook",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "integrations/claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "stripe": "^23.0.0"
  }
}
