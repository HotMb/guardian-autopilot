{
  "name": "@cleancode/shared",
  "version": "0.1.0",
  "private": false,
  "description": "Shared guarded execution contracts for CleanCode.",
  "repository": "https://github.com/HotMb/guardian-autopilot.git",
  "engines": {"node": ">=20"},
  "publishConfig": {"access": "public"},
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  }
}
