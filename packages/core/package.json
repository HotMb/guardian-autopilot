{
  "name": "@cleancode/core",
  "version": "0.1.0",
  "private": false,
  "description": "Read-only analysis and guarded reversible cleanup engine.",
  "repository": "https://github.com/HotMb/guardian-autopilot.git",
  "engines": {"node": ">=20"},
  "publishConfig": {"access": "public"},
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "import": "./dist/state-machine.js"
    },
    "./safeguards": {
      "types": "./dist/safeguards.d.ts",
      "import": "./dist/safeguards.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./confidence": {
      "types": "./dist/confidence.d.ts",
      "import": "./dist/confidence.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./duplicates": {
      "types": "./dist/duplicates.d.ts",
      "import": "./dist/duplicates.js"
    },
    "./reference-graph": {
      "types": "./dist/reference-graph.d.ts",
      "import": "./dist/reference-graph.js"
    },
    "./knip": {
      "types": "./dist/knip.d.ts",
      "import": "./dist/knip.js"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "import": "./dist/planner.js"
    },
    "./verifier": {
      "types": "./dist/verifier.d.ts",
      "import": "./dist/verifier.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./audit-log": {
      "types": "./dist/audit-log.d.ts",
      "import": "./dist/audit-log.js"
    },
    "./receipts": {
      "types": "./dist/receipts.d.ts",
      "import": "./dist/receipts.js"
    }
  },
  "scripts": {
    "build": "npm run build --prefix ../shared && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cleancode/shared": "^0.1.0",
    "typescript": "^5.8.0"
  }
}
