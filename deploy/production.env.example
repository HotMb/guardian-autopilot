# Reference only. Put real values in Google Secret Manager or protected runtime configuration.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=https://app.example.com
DATABASE_MAX_CONNECTIONS=10

# Optional billing secrets/configuration, never commit their values:
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_test_... until live launch is approved
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/billing/success
# STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/billing/cancel
# STRIPE_CHECKOUT_ACCESS_TOKEN=<long-random-token>
# Hosted GitHub commit audits require these values:
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
# GITHUB_WEBHOOK_SECRET=replace_with_github_app_webhook_secret
# DATABASE_URL=postgresql://<user>:<password>@<private-host>:5432/guardian?sslmode=require
