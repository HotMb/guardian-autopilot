# Copy to .env locally; never commit real values.
# Stripe billing is optional. Leave all STRIPE_* settings unset for the free beta.
# Configure Stripe only when paid subscriptions are intentionally enabled.
# Hosted CleanCode commit audits require all four values below; pushes are
# queued in PostgreSQL, analyzed without repository scripts, and published as
# GitHub Check Runs. The App needs Contents: read, Metadata: read, Checks: write.
# GITHUB_WEBHOOK_SECRET=replace_with_the_webhook_secret_from_github_app_settings
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# DATABASE_URL=postgresql://user:password@host:5432/guardian
# Keep the App private key and webhook secret only in the deployment secret store.
# Optional metadata endpoint credentials; all five values must be set.
# GITHUB_APP_ID=123456
# GITHUB_INSTALLATION_ID=12345678
# GITHUB_REPOSITORY_ID=123456789
# GITHUB_REPOSITORY_OWNER=HotMb
# GITHUB_REPOSITORY_NAME=guardian-autopilot
# GITHUB_API_ACCESS_TOKEN=replace_with_a_long_random_value
# Test prices provisioned in the HotMb Stripe sandbox; replace for another account.
STRIPE_PRICE_PRO=price_1UOIsGKzakOEzdSmLZvpM5wO
STRIPE_PRICE_TEAM=price_1UOIsrKzakOEzdSmcF6CZYzU
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
# Required to expose POST /billing/checkout; use a long random token and never commit it.
# STRIPE_CHECKOUT_ACCESS_TOKEN=replace_with_a_long_random_value
PORT=8787
HOST=127.0.0.1
# Optional exact browser origins, comma-separated; wildcards are not accepted.
# CORS_ORIGINS=http://localhost:3000
# Optional durable local subscription state; the path must be absolute.
# STRIPE_SUBSCRIPTION_STORE_PATH=C:\\guardian-autopilot\\subscriptions.json
# For horizontally scaled deployment, use PostgreSQL instead of the file store.
# DATABASE_URL=postgresql://user:password@host:5432/guardian
# Maximum PostgreSQL connections per webhook process; audit queue reserves one.
# DATABASE_MAX_CONNECTIONS=10
